msgid "DX-Ball's sound-pan calculation"
msgstr "DX-Ball обчислює положення звуку зліва / справа"

#: website/public/showcase/index.html:249
msgctxt "page:showcase/index.html"
msgid ""
"Recover a sound-pan calculation from a 1996 Windows game. REA's "
"instructions, caller references and numeric constants lead to a small C "
"function, checked against the original behavior and all 63 compiled bytes."
msgstr ""
