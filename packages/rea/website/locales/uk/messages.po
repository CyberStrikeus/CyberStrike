msgstr "{ph0}Головний{ph1} сторінка / початок роботи"

#: website/public/get-started/index.html:202
msgctxt "page:get-started/index.html"
msgid "Set up REA."
msgstr "Налаштуйте REA ."

#: website/public/get-started/index.html:267
msgctxt "page:get-started/index.html"
