msgctxt "page:first-investigation/index.html"
msgid "Copy setup command"
msgstr "Команда Налаштування Копіювання"

#: website/public/first-investigation/index.html:291
msgctxt "page:first-investigation/index.html"
msgid "Copy Notes investigation prompt"
msgstr "Запит на копіювання нотаток для розслідування"

