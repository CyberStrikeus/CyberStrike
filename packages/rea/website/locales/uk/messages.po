msgid "Thank you to everyone who helps make REA better."
msgstr "Дякуємо всім, хто допомагає робити REA кращим."

#: website/public/contributors/index.html:205
msgctxt "page:contributors/index.html"
msgid ""
"Code, documentation, tests, translations and ideas — there are many ways to "
"contribute."
msgstr ""
