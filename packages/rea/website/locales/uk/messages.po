msgstr "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Приклад запиту * Веб-сайт"

#: website/public/index.html:1236
msgctxt "page:index.html"
msgid "Yes, this one."
msgstr "Так, ось цей."

