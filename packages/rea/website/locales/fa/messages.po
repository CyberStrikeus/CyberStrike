#, python-brace-format
msgctxt "page:index.html"
msgid ""
"“This path multiplies by the other input. So {ph0}10% means 10% of 200{ph1} "
"after +.”"
msgstr ""
"\"این مسیر با ورودی دیگر ضرب می شود. پس {ph0}10 درصد به معنی 10 درصد از "
"200{ph1} بعد از +.”"

#: website/public/index.html:504
msgctxt "page:index.html"
msgid "Name the operands and check both operator paths."
msgstr "نام operands و بررسی هر دو مسیر اپراتور."

