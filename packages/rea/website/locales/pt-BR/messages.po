#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/index.html:500
#, python-brace-format
msgctxt "page:index.html"
msgid ""
"“This path multiplies by the other input. So {ph0}10% means 10% of 200{ph1} "
"after +.”"
msgstr ""
"\"Este caminho multiplica-se pela outra entrada. Então {ph0}10% significa "
"10% de 200{ph1} depois de +.”"

#: website/public/index.html:504
msgctxt "page:index.html"
msgid "Name the operands and check both operator paths."
msgstr "Nomeie os operandos e verifique os dois caminhos do operador."

