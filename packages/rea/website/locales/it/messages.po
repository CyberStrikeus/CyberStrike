#: website/public/showcase/ctf/index.html:204
msgctxt "page:showcase/ctf/index.html"
msgid "Case study · DownUnderCTF 2023"
msgstr "Caso di studio * DownUnderCTF 2023"

#. {ph0}: <br />
#: website/public/showcase/ctf/index.html:205
#, python-brace-format
msgctxt "page:showcase/ctf/index.html"
msgid "Find the flag in{ph0}a CTF binary."
msgstr "Trova la bandiera in{ph0}un binario CTF."

#. {ph0}: <code>Correct!</code>
#: website/public/showcase/ctf/index.html:206
#, python-brace-format
msgctxt "page:showcase/ctf/index.html"
msgid ""
"Use REA to inspect a small flag checker, turn its rules into equations and "
"find an input that makes the original program print {ph0}."
msgstr ""
"Usa REA per ispezionare un piccolo correttore di flag, trasformare le sue "
"regole in equazioni e trovare un input che faccia stampare il programma "
"originale {ph0}."

#: website/public/showcase/ctf/index.html:211
msgctxt "page:showcase/ctf/index.html"
msgid "masked squares flag checker · Easy · Linux x86-64"
msgstr "quadrati mascherati bandiera checker * Facile * Linux x86-64"

#: website/public/showcase/ctf/index.html:214
msgctxt "page:showcase/ctf/index.html"
msgid "View the original challenge"
msgstr "Visualizza la sfida originale"

#: website/public/showcase/ctf/index.html:222
msgctxt "page:showcase/ctf/index.html"
msgid "From a binary to a checked answer"
msgstr "Da un binario a una risposta controllata"

