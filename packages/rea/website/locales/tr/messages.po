msgstr "{ph0}01{ph1} Zaman bloğu"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/showcase/aegis/index.html:502
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid "{ph0}02{ph1} Key + block"
msgstr "{ph0}02{ph1} Anahtar + blok"

