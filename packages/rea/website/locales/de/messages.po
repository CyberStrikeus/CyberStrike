#. {ph2}: </i>
#. {ph3}: <i>
#. {ph4}: </i>
#. {ph5}: <i>
#. {ph6}: </i>
#. {ph7}: </span >
#: website/public/index.html:839
#, python-brace-format
msgctxt "page:index.html"
msgid "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Example question · Calculator"
msgstr ""
"{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Beispielfrage · Taschenrechner"

#: website/public/index.html:862
msgctxt "page:index.html"
msgid "2. Find both rules"
msgstr "2. Beide Regeln finden"

#: website/public/index.html:863
msgctxt "page:index.html"
msgid ""
"REA helps the agent read the code behind the % button. It applies two "
"different rules:"
msgstr ""
"REA hilft dem Agenten, den Code hinter der %-Taste zu lesen. Er wendet zwei "
"unterschiedliche Regeln an:"

#: website/public/index.html:884
msgctxt "page:index.html"
msgid "3. Try the % button"
msgstr "3. Die %-Taste ausprobieren"

#: website/public/index.html:885
msgctxt "page:index.html"
msgid "We recreated both rules below. Choose + or ×, press %, then press =."
msgstr ""
"Wir haben beide Regeln unten nachgebaut. Wähle + oder ×, drücke % und dann "
"=."

