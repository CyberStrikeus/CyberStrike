msgid "Mismatch{ph0}{ph1}Revise the hypothesis{ph2}"
msgstr "ไม่ตรงกัน{ph0}{ph1}แก้ไขสมมติฐาน{ph2}"

#. {ph0}: <br />
#. {ph1}: <strong>
#. {ph2}: </strong>
#: website/public/blog/touhou-reconstruction/index.html:349
#, python-brace-format
msgctxt "page:blog/touhou-reconstruction/index.html"
msgid "A better{ph0}{ph1}starting point{ph2}"
msgstr "ดีกว่า{ph0}{ph1}จุดเริ่มต้น{ph2}"

#: website/public/blog/touhou-reconstruction/index.html:352
msgctxt "page:blog/touhou-reconstruction/index.html"
msgid "Reuse"
msgstr "นำกลับมาใช้"

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/blog/touhou-reconstruction/index.html:353
