#: website/public/showcase/aegis/index.html:428
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0} is the calculation candidate; the other two concern the progress bar "
"and imported accounts. TOTP means a time-based one-time password."
msgstr ""
"{ph0} là ứng cử viên tính toán; hai người còn lại liên quan đến thanh tiến "
"trình và tài khoản nhập khẩu.  TOTP có nghĩa là mật khẩu một lần dựa trên "
"thời gian."

#: website/public/showcase/aegis/index.html:435
msgctxt "page:showcase/aegis/index.html"
msgid "Connect the generator to the app's display"
msgstr "Kết nối máy phát điện với màn hình của ứng dụng"

#. {ph0}: <code>EntryHolder.getOtp</code>
#. {ph1}: <code>TotpInfo.getOtp(timestamp)</code>
