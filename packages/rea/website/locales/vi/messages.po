msgctxt "page:guides/native/index.html"
msgid ""
"After {ph0}connecting REA to your agent{ph1} and {ph2}setting up a native "
"analysis tool{ph3}, provide the local executable and a question:"
msgstr ""
"Sau {ph0}kết NỐI REA với agent của bạn{ph1} và {ph2}thiết lập phân tích công"
" cụ chương trình mã máy{ph3}, cung cấp thực thi cục bộ và một câu hỏi:"

#: website/public/guides/native/index.html:313
msgctxt "page:guides/native/index.html"
msgid "Which analysis tool should I use?"
msgstr "Tôi nên sử dụng công cụ phân tích nào?"

#: website/public/guides/native/index.html:314
msgctxt "page:guides/native/index.html"
msgid "REA needs one of these to read native programs:"
msgstr "REA cần một trong số này để đọc các chương trình gốc:"

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/guides/native/index.html:323
#, python-brace-format
msgctxt "page:guides/native/index.html"
msgid ""
"{ph0}Ghidra{ph1} (macOS or Linux; experimental on Windows): free, but needs "
"an existing Ghidra 12.1.x installation and a 64-bit JDK 21 or newer."
msgstr ""
"{ph0} Ghidra {ph1} (macOS hoặc Linux ; thử nghiệm TRÊN Windows ): miễn phí, "
"nhưng cần Ghidra 12.1 hiện có.x cài đặt và 64-bit JDK 21 hoặc mới hơn."

