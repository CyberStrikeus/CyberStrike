#. {ph1}: </a>
#: website/public/index.html:1264
#, python-brace-format
msgctxt "page:index.html"
msgid "{ph0}See the DX-Ball case study →{ph1}"
msgstr "{ph0}Zobacz studium przypadku DX-Ball →{ph1}"

#: website/public/index.html:1218
msgctxt "page:index.html"
msgid "Copy website project prompt"
msgstr "Skopiuj monit projektu witryny"

#: website/public/index.html:1246
msgctxt "page:index.html"
msgid "Copy game reconstruction prompt"
msgstr "Skopiuj monit o rekonstrukcję gry"

