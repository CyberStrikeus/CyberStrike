{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "500MB",
  "globalDependencies": [".nvmrc", ".npmrc"],
  "globalPassThroughEnv": [
    "GOMAXPROCS",
    "GOMEMLIMIT",
    "UV_THREADPOOL_SIZE",
    "REA_TYPESCRIPT_COMPILER"
  ],
  "tasks": {
    "compile": {
      "dependsOn": ["metadata:check"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/run-turbo.mjs",
        "scripts/run-typescript.mjs",
        "scripts/check-dependency-install.mjs",
        "scripts/clean-build-output.mjs",
        "scripts/bundle-runtime.mjs",
        "scripts/record-catalog-digests.mjs",
        "scripts/record-mcp-catalog.mjs",
        "scripts/generate-package-metadata.mjs",
        "src/**/*.{cts,mts,ts,tsx}",
        "src/**/package.json",
        "!src/**/*.test.ts",
        "!src/**/*.fixture.ts",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"],
      "env": ["REA_TYPESCRIPT_COMPILER"]
    },
    "typecheck": {
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/run-turbo.mjs",
        "scripts/run-typescript.mjs",
        "src/**/*.{cts,mts,ts,tsx}",
        "src/**/package.json",
        "tests/**/*.{cts,mts,ts,tsx}",
        "tests/**/package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "vitest.config.ts",
        "scripts/**/*.d.{cts,mts,ts}",
        "scripts/**/package.json",
        ".github/actions/**/*.{cts,mts,ts,tsx}",
        ".github/**/package.json",
        "docs/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "docs/**/package.json",
        "!docs/.vitepress/cache/**",
        "!docs/.vitepress/dist/**"
      ],
      "outputs": [],
      "env": ["REA_TYPESCRIPT_COMPILER"]
    },
    "metadata:check": {
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-package-metadata.mjs",
        "scripts/lib/generated-file.mjs",
        "scripts/lib/verifier-source-loader.mjs",
        "src/domain/skillManifest.ts",
        "src/domain/result.ts",
        ".agents/skills/reverse-engineer-anything/SKILL.md",
        "src/generatedPackageMetadata.ts"
      ]
    },
    "lint": {
      "outputs": [".cache/static-checks/oxlint.json"],
      "inputs": [
        ".gitignore",
        ".oxlintrc.json",
        "package.json",
        "package-lock.json",
        "scripts/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "src/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "tests/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "docs/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        ".github/actions/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "website/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "!docs/.vitepress/cache/**",
        "!docs/.vitepress/dist/**",
        "!website/_site/**",
        "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
      ]
    },
    "format:check": {},
    "knip": {
      "dependsOn": ["compile"],
      "inputs": [
        ".gitignore",
        "knip.json",
        "package.json",
        "package-lock.json",
        "scripts/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "src/**/*.ts",
        "tests/**/*.ts",
        ".github/actions/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        ".github/**/package.json",
        ".github/workflows/*.{yml,yaml}",
        ".github/**/action.{yml,yaml}",
        "tsconfig.json",
        "tsconfig.build.json",
        "docs/.vitepress/config.ts",
        "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}"
      ]
    },
    "jscpd": {
      "inputs": [
        ".gitignore",
        ".jscpd.json",
        "package.json",
        "package-lock.json",
        "scripts/ci/static-check-report.mjs",
        "src/**",
        "tests/**"
      ],
      "outputs": [".cache/static-checks/jscpd/jscpd-report.json"]
    },
    "scan:todos": {
      "inputs": [
        "bridge/**/*.{java,py}",
        "scripts/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "test:run": {
      "cache": false,
      "dependsOn": [
        "artifacts:mcp-catalog",
        "artifacts:product-catalog",
        "artifacts:managed-evidence",
        "artifacts:skills"
      ]
    },
    "docs:check:built": {
      "dependsOn": [
        "artifacts:product-catalog",
        "artifacts:managed-evidence",
        "artifacts:skills"
      ],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-*.mjs",
        "scripts/check-doc-facts.mjs",
        "scripts/lib/*.mjs",
        "scripts/verify/managed/*.mjs",
        "scripts/fixtures/managed/*.mjs",
        "scripts/verify/apple/*.mjs",
        "scripts/fixtures/apple/*.mjs",
        "src/generated*.ts",
        "src/contracts/**/*.ts",
        "licenses/**",
        "docs/**",
        "!docs/public/product-catalog.json",
        "!docs/verification/managed-conformance-*.json",
        ".agents/skills/reverse-engineer-anything/**",
        "README*.md",
        {
          "mode": "dependencyOutputs",
          "globs": [
            "skills/**",
            "docs/public/product-catalog.json",
            "docs/verification/managed-conformance-manifest.json",
            "docs/verification/managed-conformance-ledger.json"
          ]
        }
      ]
    },
    "artifacts:mcp-catalog": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-mcp-tool-catalog.mjs",
        "scripts/lib/generated-file.mjs"
      ],
      "outputs": [".cache/mcp-tool-catalog.json"]
    },
    "artifacts:skills": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-skill-metadata.mjs",
        "scripts/lib/generated-file.mjs",
        "scripts/lib/verifier-source-loader.mjs",
        ".agents/skills/reverse-engineer-anything/**"
      ],
      "outputs": ["skills/**"]
    },
    "artifacts:product-catalog": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-product-catalog.mjs",
        "scripts/lib/**/*.mjs",
        ".oxfmtrc.json"
      ],
      "outputs": ["docs/public/product-catalog.json"]
    },
    "artifacts:managed-evidence": {
      "dependsOn": ["artifacts:skills"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-completion-ledger.mjs",
        "scripts/lib/generated-file.mjs",
        "scripts/verify/managed/**",
        "scripts/fixtures/managed/**"
      ],
      "outputs": [
        "docs/verification/managed-conformance-manifest.json",
        "docs/verification/managed-conformance-ledger.json"
      ]
    },
    "artifacts:error-schema": {
      "dependsOn": ["compile"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-error-schema.mjs",
        "scripts/lib/generated-file.mjs",
        "scripts/lib/format-generated-file.mjs",
        ".oxfmtrc.json"
      ],
      "outputs": ["docs/error-contract.schema.json"]
    },
    "mcp-catalog:check:built": {
      "dependsOn": ["artifacts:mcp-catalog"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-mcp-tool-catalog.mjs",
        "scripts/lib/generated-file.mjs",
        {
          "mode": "dependencyOutputs",
          "globs": [".cache/mcp-tool-catalog.json"]
        }
      ]
    },
    "evidence:check:built": {
      "dependsOn": ["artifacts:managed-evidence"],
      "inputs": [
        "package.json",
        "package-lock.json",
        "scripts/generate-completion-ledger.mjs",
        "scripts/lib/generated-file.mjs",
        "scripts/verify/managed/**",
        "scripts/fixtures/managed/**",
        {
          "mode": "dependencyOutputs",
          "globs": [
            "docs/verification/managed-conformance-manifest.json",
            "docs/verification/managed-conformance-ledger.json"
          ]
        }
      ]
    }
  }
}
