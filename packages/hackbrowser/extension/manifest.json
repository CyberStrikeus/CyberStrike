{
  "manifest_version": 3,
  "name": "CyberStrike HackBrowser 2.0",
  "version": "0.1.0",
  "description": "Streams full browser network traffic to CyberStrike for security testing.",
  "permissions": ["debugger", "tabs", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "CyberStrike: attach capture to this tab",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
