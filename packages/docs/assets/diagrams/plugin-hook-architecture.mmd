flowchart TD
    P["Plugin: (input) =&gt; Hooks"]:::plugin --> LLM["LLM call"]
    LLM --> H1["chat.params · chat.headers<br/>modify params / headers"]:::hook
    H1 --> DEC["Agent picks a tool"]
    DEC --> H2["permission.ask<br/>allow · deny · ask"]:::hook
