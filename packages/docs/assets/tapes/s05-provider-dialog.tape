Output "/tmp/shot_s05-provider-dialog.mp4"
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 26
Set Width 2000
Set Height 1300
Set Padding 32
Hide
Type "cd /tmp/acme-shop && clear"
Enter
Sleep 400ms
Type "cyberstrike"
Enter
Sleep 5s
Show
Type "/connect"
Enter
Sleep 2s
Ctrl+C
Sleep 300ms
