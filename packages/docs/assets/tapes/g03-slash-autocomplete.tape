Output "public/docs/images/gifs/g03-slash-autocomplete.gif"
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 26
Set Width 2000
Set Height 1300
Set Padding 32
Hide
Type "cd /tmp/acme-shop && clear"
Enter
Sleep 400ms
Type "cyberstrike"
Enter
Sleep 5s
Show
Type "/"
Sleep 1500ms
Type "se"
Sleep 2s
Ctrl+C
Sleep 300ms
