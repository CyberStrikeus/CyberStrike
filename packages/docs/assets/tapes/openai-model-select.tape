Output "/tmp/shot_openai-model-select.mp4"
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 26
Set Width 2000
Set Height 1300
Set Padding 32
Hide
Type "cd /tmp/acme-shop && clear"
Enter
Sleep 400ms
Type "cyberstrike"
Enter
Sleep 5s
Show
Ctrl+X
Sleep 300ms
Type "m"
Sleep 800ms
Type "gpt"
Sleep 1500ms
Ctrl+C
Sleep 300ms
