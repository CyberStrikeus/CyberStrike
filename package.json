{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "cyberstrike",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite packages/app",
    "start": "vite packages/app",
    "dev:web": "vite packages/app",
    "dev:cli": "bun run --cwd packages/cyberstrike --conditions=browser src/index.ts",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": [
    "packages/app",
    "packages/core",
    "packages/effect-drizzle-sqlite",
    "packages/effect-sqlite-node",
    "packages/http-recorder",
    "packages/llm",
    "packages/plugin",
    "packages/schema",
    "packages/sdk/js",
    "packages/session-ui",
    "packages/ui",
    "packages/util"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "typescript": "5.8.2",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberStrikeus/CyberStrike"
  },
  "license": "AGPL-3.0-only",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
